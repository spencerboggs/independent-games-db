---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Independent Game DB",
  description = "A public dataset of independent games, the studios and publishers behind them, and the technologies they use.",
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Idiqlat:wght@200;300;400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("igdb-theme");
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: light)").matches
                ? "light"
                : "dark";
          document.documentElement.dataset.theme = theme;
        } catch {
          // Keep the dark default.
        }
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>

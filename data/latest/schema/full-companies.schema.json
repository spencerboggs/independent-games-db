{
  "$id": "https://raw.githubusercontent.com/spencerboggs/independent-games-db/main/data/latest/schema/full-companies.schema.json",
  "title": "Companies (full)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable internal database identifier. Never derived at read time; never reused."
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "roles": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "developer",
            "publisher",
            "studio",
            "porting",
            "support",
            "holding",
            "investor"
          ]
        }
      },
      "description": {
        "type": "object",
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string",
                    "enum": [
                      "database",
                      "third-party",
                      "cc0"
                    ],
                    "description": "database = written for this database (repository data license); third-party = quoted from the source, rights stay with the source; cc0 = public domain dedication (e.g. Wikidata)."
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "official",
                          "steam",
                          "igdb",
                          "wikidata",
                          "developer-interview",
                          "job-posting",
                          "technical-article",
                          "community",
                          "inferred",
                          "manual"
                        ]
                      },
                      "url": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^https?:\\/\\/\\S+$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "retrievedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false,
                    "description": "Where a fact came from."
                  }
                },
                "required": [
                  "text",
                  "license",
                  "source"
                ],
                "additionalProperties": false,
                "description": "Third-party text is never relicensed. Check `license` before reusing."
              },
              {
                "type": "null"
              }
            ],
            "description": "Text quoted from an external source, with attribution."
          },
          "custom": {
            "description": "Database-authored text, covered by the repository data license.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "custom"
        ],
        "additionalProperties": false
      },
      "website": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^https?:\\/\\/\\S+$"
          },
          {
            "type": "null"
          }
        ]
      },
      "socialLinks": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "string",
          "pattern": "^https?:\\/\\/\\S+$"
        },
        "description": "Named URLs, e.g. official, steam, wikidata, igdb."
      },
      "location": {
        "type": "object",
        "properties": {
          "headquarters": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "ISO 3166-1 alpha-2 country code."
          },
          "countryName": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "headquarters",
          "country",
          "countryName"
        ],
        "additionalProperties": false
      },
      "founded": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1800,
            "maximum": 2100
          },
          {
            "type": "null"
          }
        ],
        "description": "Founding year."
      },
      "foundedDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
          },
          {
            "type": "null"
          }
        ]
      },
      "ownership": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "independent",
              "subsidiary",
              "acquired",
              "public",
              "defunct",
              "unknown"
            ]
          },
          "parentCompany": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable internal database identifier. Never derived at read time; never reused."
              },
              {
                "type": "null"
              }
            ],
            "description": "Parent company ID when the parent exists in this database."
          },
          "parentCompanyName": {
            "description": "Parent company name (always set when a parent is known).",
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "status",
          "parentCompany",
          "parentCompanyName",
          "notes"
        ],
        "additionalProperties": false
      },
      "externalIds": {
        "type": "object",
        "properties": {
          "wikidata": {
            "type": "string",
            "pattern": "^Q\\d+$"
          },
          "igdb": {
            "type": "string"
          },
          "steam": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "string"
        },
        "description": "Identifiers of this entity in external databases, keyed by provider."
      },
      "logo": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/\\S+$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "logo",
                  "header",
                  "capsule",
                  "background",
                  "screenshot",
                  "cover",
                  "artwork",
                  "icon"
                ]
              },
              "source": {
                "type": "string",
                "enum": [
                  "official",
                  "steam",
                  "igdb",
                  "wikidata",
                  "developer-interview",
                  "job-posting",
                  "technical-article",
                  "community",
                  "inferred",
                  "manual"
                ]
              },
              "retrievedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "rights": {
                "type": "string",
                "enum": [
                  "reference-only",
                  "redistributable",
                  "unknown"
                ],
                "description": "reference-only: the file is not copied into this repository; link to it, do not rehost without permission."
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "url",
              "type",
              "source",
              "retrievedAt",
              "rights"
            ],
            "additionalProperties": false,
            "description": "A pointer to third-party artwork. Assets are never copied into the repository."
          },
          {
            "type": "null"
          }
        ]
      },
      "classification": {
        "type": "object",
        "properties": {
          "include": {
            "type": "boolean",
            "description": "true = part of the curated set. false = present only because an included game references it."
          },
          "category": {
            "type": "string",
            "enum": [
              "independent",
              "independent-large",
              "independent-publisher",
              "acquired-independent",
              "subsidiary",
              "AAA-adjacent",
              "other",
              "excluded",
              "unclassified"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "include",
          "category",
          "notes"
        ],
        "additionalProperties": false,
        "description": "Editorial classification. Always manually controlled."
      },
      "games": {
        "type": "object",
        "properties": {
          "developed": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Stable internal database identifier. Never derived at read time; never reused."
            }
          },
          "published": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Stable internal database identifier. Never derived at read time; never reused."
            }
          }
        },
        "required": [
          "developed",
          "published"
        ],
        "additionalProperties": false
      },
      "statistics": {
        "type": "object",
        "properties": {
          "gameCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "developedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "publishedCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "totalSteamReviews": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "averagePositivePercentage": {
            "type": [
              "number",
              "null"
            ]
          },
          "weightedPositivePercentage": {
            "type": [
              "number",
              "null"
            ]
          },
          "mostReviewedGame": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable internal database identifier. Never derived at read time; never reused."
              },
              {
                "type": "null"
              }
            ]
          },
          "mostRecentRelease": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable internal database identifier. Never derived at read time; never reused."
              },
              {
                "type": "null"
              }
            ]
          },
          "firstRelease": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 96,
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "description": "Stable internal database identifier. Never derived at read time; never reused."
              },
              {
                "type": "null"
              }
            ]
          },
          "technologyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "engineCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "engines": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 96,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Stable internal database identifier. Never derived at read time; never reused."
            }
          }
        },
        "required": [
          "gameCount",
          "developedCount",
          "publishedCount",
          "totalSteamReviews",
          "averagePositivePercentage",
          "weightedPositivePercentage",
          "mostReviewedGame",
          "mostRecentRelease",
          "firstRelease",
          "technologyCount",
          "engineCount",
          "engines"
        ],
        "additionalProperties": false
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "official",
                "steam",
                "igdb",
                "wikidata",
                "developer-interview",
                "job-posting",
                "technical-article",
                "community",
                "inferred",
                "manual"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrievedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Where a fact came from."
        }
      },
      "provenance": {
        "type": "object",
        "propertyNames": {
          "type": "string"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "enum": [
                "official",
                "steam",
                "igdb",
                "wikidata",
                "developer-interview",
                "job-posting",
                "technical-article",
                "community",
                "inferred",
                "manual"
              ]
            },
            "confidence": {
              "type": "string",
              "enum": [
                "verified",
                "high",
                "medium",
                "low",
                "inferred"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrievedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "alternatives": {
              "description": "Values other sources reported for this field, when they disagreed.",
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "enum": [
                      "official",
                      "steam",
                      "igdb",
                      "wikidata",
                      "developer-interview",
                      "job-posting",
                      "technical-article",
                      "community",
                      "inferred",
                      "manual"
                    ]
                  },
                  "value": {}
                },
                "required": [
                  "source",
                  "value"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "source",
            "confidence"
          ],
          "additionalProperties": false
        },
        "description": "Per-field provenance, keyed by field path. Full variant only."
      },
      "lastUpdated": {
        "type": "string",
        "description": "ISO 8601 timestamp (UTC)"
      }
    },
    "required": [
      "id",
      "name",
      "aliases",
      "roles",
      "description",
      "website",
      "socialLinks",
      "location",
      "founded",
      "foundedDate",
      "ownership",
      "externalIds",
      "logo",
      "classification",
      "games",
      "statistics",
      "sources",
      "lastUpdated"
    ],
    "additionalProperties": false
  }
}

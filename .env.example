# IGDB (optional). Create a Twitch application at https://dev.twitch.tv/console/apps
# and copy its Client ID and a generated Client Secret. When these are absent the
# IGDB provider is skipped automatically.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Steam (optional). None of the endpoints used by this project require a key.
# STEAM_API_KEY=

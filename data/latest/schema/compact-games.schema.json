{
  "$id": "https://raw.githubusercontent.com/spencerboggs/independent-games-db/main/data/latest/schema/compact-games.schema.json",
  "title": "Games (compact)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable internal database identifier. Never derived at read time; never reused."
      },
      "title": {
        "type": "string"
      },
      "type": {
        "type": "string",
        "enum": [
          "game",
          "dlc",
          "expansion",
          "remaster",
          "remake",
          "port",
          "bundle",
          "demo",
          "other"
        ]
      },
      "releaseDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
          },
          {
            "type": "null"
          }
        ]
      },
      "developers": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable internal database identifier. Never derived at read time; never reused."
        }
      },
      "publishers": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable internal database identifier. Never derived at read time; never reused."
        }
      },
      "platforms": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "genres": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "engines": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable internal database identifier. Never derived at read time; never reused."
        }
      },
      "steamAppId": {
        "type": [
          "string",
          "null"
        ]
      },
      "reviewCount": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "null"
          }
        ]
      },
      "positivePercentage": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "title",
      "type",
      "releaseDate",
      "developers",
      "publishers",
      "platforms",
      "genres",
      "engines",
      "steamAppId",
      "reviewCount",
      "positivePercentage"
    ],
    "additionalProperties": false
  }
}

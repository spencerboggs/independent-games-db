{
  "$id": "https://raw.githubusercontent.com/spencerboggs/independent-games-db/main/data/latest/schema/games.schema.json",
  "title": "Games (standard)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable internal database identifier. Never derived at read time; never reused."
      },
      "title": {
        "type": "string",
        "minLength": 1
      },
      "alternateTitles": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "type": {
        "type": "string",
        "enum": [
          "game",
          "dlc",
          "expansion",
          "remaster",
          "remake",
          "port",
          "bundle",
          "demo",
          "other"
        ]
      },
      "releaseDate": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^\\d{4}(?:-\\d{2}(?:-\\d{2})?)?$"
          },
          {
            "type": "null"
          }
        ]
      },
      "releaseDatePrecision": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "day",
              "month",
              "year"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "releaseStatus": {
        "type": "string",
        "enum": [
          "released",
          "early-access",
          "upcoming",
          "cancelled",
          "unknown"
        ]
      },
      "developers": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable internal database identifier. Never derived at read time; never reused."
        },
        "description": "Company IDs."
      },
      "publishers": {
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 96,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Stable internal database identifier. Never derived at read time; never reused."
        },
        "description": "Company IDs."
      },
      "descriptions": {
        "type": "object",
        "properties": {
          "source": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string"
                  },
                  "license": {
                    "type": "string",
                    "enum": [
                      "database",
                      "third-party",
                      "cc0"
                    ],
                    "description": "database = written for this database (repository data license); third-party = quoted from the source, rights stay with the source; cc0 = public domain dedication (e.g. Wikidata)."
                  },
                  "source": {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "enum": [
                          "official",
                          "steam",
                          "igdb",
                          "wikidata",
                          "developer-interview",
                          "job-posting",
                          "technical-article",
                          "community",
                          "inferred",
                          "manual"
                        ]
                      },
                      "url": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^https?:\\/\\/\\S+$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "retrievedAt": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "note": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    },
                    "required": [
                      "type"
                    ],
                    "additionalProperties": false,
                    "description": "Where a fact came from."
                  }
                },
                "required": [
                  "text",
                  "license",
                  "source"
                ],
                "additionalProperties": false,
                "description": "Third-party text is never relicensed. Check `license` before reusing."
              },
              {
                "type": "null"
              }
            ],
            "description": "Text quoted from an external source, with attribution."
          },
          "custom": {
            "description": "Database-authored text, covered by the repository data license.",
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source",
          "custom"
        ],
        "additionalProperties": false

{
  "$id": "https://raw.githubusercontent.com/spencerboggs/independent-games-db/main/data/latest/schema/relationships.schema.json",
  "title": "Relationships",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "description": "Deterministic: `${from}:${type}:${to}`."
      },
      "from": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable internal database identifier. Never derived at read time; never reused."
      },
      "fromType": {
        "type": "string",
        "enum": [
          "company",
          "game",
          "person",
          "technology"
        ]
      },
      "type": {
        "type": "string",
        "enum": [
          "developer",
          "publisher",
          "porting",
          "support",
          "uses-engine",
          "uses-middleware",
          "uses-language",
          "uses-tool",
          "subsidiary-of",
          "dlc-of",
          "remaster-of",
          "port-of",
          "affiliated-with",
          "credited-on"
        ]
      },
      "to": {
        "type": "string",
        "maxLength": 96,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "description": "Stable internal database identifier. Never derived at read time; never reused."
      },
      "toType": {
        "type": "string",
        "enum": [
          "company",
          "game",
          "person",
          "technology"
        ]
      },
      "confidence": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "verified",
              "high",
              "medium",
              "low",
              "inferred"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "sources": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "official",
                "steam",
                "igdb",
                "wikidata",
                "developer-interview",
                "job-posting",
                "technical-article",
                "community",
                "inferred",
                "manual"
              ]
            },
            "url": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^https?:\\/\\/\\S+$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "retrievedAt": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "description": "Where a fact came from."
        }
      }
    },
    "required": [
      "id",
      "from",
      "fromType",
      "type",
      "to",
      "toType",
      "confidence",
      "sources"
    ],
    "additionalProperties": false
  }
}
